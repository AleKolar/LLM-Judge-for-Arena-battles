# ════════════════════════════════════════════════════════════════
# LLM Judge for Arena Battles - Configuration
# ════════════════════════════════════════════════════════════════

# РЕКОМЕНДУЕТСЯ: Hugging Face API (бесплатный)
# Получить токен: https://huggingface.co/settings/tokens
# 1. Создайте User Access Token
# 2. Выберите право "Inference"
# 3. Скопируйте токен сюда
HUGGINGFACE_API_KEY=hf_your_token_here

# FALLBACK: OpenRouter API (если HF недоступен)
# Получить ключ: https://openrouter.ai/keys
# Примечание: OpenRouter может быть недоступен из некоторых стран/регионов
# из-за CloudFlare защиты. Используйте как резерв.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ════════════════════════════════════════════════════════════════
# Примечания:
# - Hugging Face: Бесплатно, не требует кредитной карты
# - OpenRouter: Бесплатные модели доступны, может потребоваться VPN
# ════════════════════════════════════════════════════════════════
